{
  "name": "devils-plan-3",
  "main": "multiplayer/worker.mjs",
  "compatibility_date": "2026-02-01",
  "workers_dev": true,
  "build": {"command": "node multiplayer/build.mjs"},
  "assets": {
    "directory": "public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "durable_objects": {
    "bindings": [{"name": "ROOMS", "class_name": "GameRoom"}]
  },
  "migrations": [{"tag": "v1", "new_sqlite_classes": ["GameRoom"]}]
}
